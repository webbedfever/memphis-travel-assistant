<main class="auth-page">
  <section class="auth-card">
    <div class="auth-card-header">
      <p class="auth-kicker">Password reset</p>
      <h1>Reset your password</h1>
      <p>Enter your account email and we will send you a reset link.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth-field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com" %>
      </div>

      <%= f.submit "Send reset link", class: "auth-submit" %>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </section>
</main>
