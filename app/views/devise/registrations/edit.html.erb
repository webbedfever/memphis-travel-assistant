<main class="auth-page">
  <section class="auth-card auth-card-centered">
    <div class="auth-card-header">
      <p class="auth-kicker">Account</p>
      <h1>Edit account</h1>
      <p>Update your email or password.</p>
    </div>

    <div class="auth-error">
      <%= render "devise/shared/error_messages", resource: resource %>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
      <div class="auth-field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "New password" %>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <span class="auth-hint">
          Leave blank to keep your current password<%= @minimum_password_length ? "; #{@minimum_password_length} characters minimum" : "" %>.
        </span>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation, "Confirm new password" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <div class="auth-field">
        <%= f.label :current_password %>
        <%= f.password_field :current_password, autocomplete: "current-password" %>
        <span class="auth-hint">Required to confirm account changes.</span>
      </div>

      <%= f.submit "Update account", class: "auth-submit" %>
    <% end %>

    <div class="auth-secondary">
      <p><%= link_to "Back to account", account_path, class: "auth-link" %></p>
      <p>
        <%= button_to "Cancel my account",
              registration_path(resource_name),
              method: :delete,
              class: "auth-danger-link",
              data: { turbo_confirm: "Are you sure?" } %>
      </p>
    </div>
  </section>
</main>
