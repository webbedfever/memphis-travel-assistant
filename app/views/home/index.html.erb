<!DOCTYPE html>
<html>
  <head>
    <title>Memphis Travel Assistant</title>

    <style>
      body { font-family: Arial; }

      .top-right {
        position: absolute;
        top: 20px;
        right: 20px;
        display: flex;
        gap: 10px;
      }

      .btn {
        padding: 10px 14px;
        border: none;
        cursor: pointer;
        background: black;
        color: white;
      }

      .feed {
        margin-top: 80px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: center;
      }

      .post-card {
        width: 400px;
        border: 1px solid #ddd;
        border-radius: 10px;
        overflow: hidden;
        text-decoration: none;
        color: black;
      }

      .post-card img {
        width: 100%;
        height: 250px;
        object-fit: cover;
      }

      .post-card-content {
        padding: 10px;
      }
    </style>
  </head>

  <body>

    <!-- TOP NAV -->
    <div class="top-right">
      <%= link_to "Map", maps_path, class: "btn" %>

      <% if user_signed_in? %>
        <%= link_to "Create Post", new_post_path, class: "btn" %>
        <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "btn" %>
      <% else %>
        <%= link_to "Sign In", new_user_session_path, class: "btn" %>
      <% end %>
    </div>

    <h1>Memphis Travel Assistant</h1>

    <!-- FEED -->
    <div class="feed">
      <% @posts.each do |post| %>
        <a href="/posts/<%= post.id %>" class="post-card">
          <% if post.image_url.present? %>
            <img src="<%= post.image_url %>">
          <% end %>

          <div class="post-card-content">
            <h3><%= post.title %></h3>
            <p><%= post.description %></p>
          </div>
        </a>
      <% end %>
    </div>

  </body>
</html>