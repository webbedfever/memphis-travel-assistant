<h1>Memphis Travel Assistant</h1>

<style>
  .feed {
    margin-top: 80px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
  }

  .post-card {
    width: 400px;
    border: 1px solid #ddd;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: black;
  }

  .post-card img {
    width: 100%;
    height: 250px;
    object-fit: cover;
  }

  .post-card-content {
    padding: 10px;
  }
</style>

<!-- FEED -->
<div class="feed">
  <% @posts.each do |post| %>
    <a href="/posts/<%= post.id %>" class="post-card">
      <% if post.image_url.present? %>
        <img src="<%= post.image_url %>">
      <% end %>

      <div class="post-card-content">
        <h3><%= post.title %></h3>
        <p><%= post.description %></p>
      </div>
    </a>
  <% end %>
</div>