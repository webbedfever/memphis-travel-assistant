<main class="home-page">
  <section class="home-hero">
    <div class="home-hero-copy">
      <p class="home-eyebrow">Memphis Travel Assistant</p>
      <h1>Plan a better Memphis day.</h1>
      <p class="home-lede">
        Find nearby places, check conditions, map your route, and keep the best stops in one planner.
      </p>
      <div class="home-actions">
        <%= link_to "Start with Maps", maps_path, class: "home-primary-action" %>
        <%= link_to "View Dashboard", dashboard_path, class: "home-secondary-action" %>
      </div>
    </div>

    <div class="home-trip-panel" aria-label="Planning overview">
      <div class="home-panel-heading">
        <span>How it helps</span>
        <strong>Your trip, organized</strong>
      </div>

      <div class="home-overview-list">
        <div class="home-overview-item">
          <span>1</span>
          <strong>Open Maps to discover stops.</strong>
        </div>

        <div class="home-overview-item">
          <span>2</span>
          <strong>Save the places and events worth keeping.</strong>
        </div>

        <div class="home-overview-item">
          <span>3</span>
          <strong>Edit the plan, then use Dashboard as command center.</strong>
        </div>
      </div>
    </div>
  </section>
</main>
