<input id="origin" placeholder="Start location">
<input id="destination" placeholder="Destination">
<button onclick="getDirections()">Get Directions</button>

<div id="map" style="height: 500px;"></div>

<input type="date" id="startDate">
<input type="date" id="endDate">
<button onclick="loadEvents()">Filter Events</button>

<select id="classification">
    <option value="">All Events</option>
    <option value="Music">Music</option>
    <option value="Sports">Sports</option>
    <option value="Arts & Theatre">Arts & Theatre</option>
    <option value="Film">Film</option>
    <option value="Miscellaneous">Misc</option>
</select>

<button onclick="loadEvents()">Apply Filters</button>

<script>
let markers = [];
let map;
let directionsService;
let directionsRenderer;
let originAutocomplete;
let destinationAutocomplete;

const memphisBounds = {
    north: 35.3,
    south: 35.0,
    west: -90.2,
    east: -89.8,
};

function groupByVenue(events) {
    const groups = {};

    events.forEach(event => {
        if (!event.lat || !event.lng) return;

        const key = `${event.lat},${event.lng}`;

        if (!groups[key]) {
            groups[key] = {
                lat: event.lat,
                lng: event.lng,
                venue: event.venue,
                events: []
            };
        }

        groups[key].events.push(event);
    });

    return Object.values(groups);
}

async function loadEvents() {
    markers.forEach(marker => marker.setMap(null));
    markers = [];

    const start = document.getElementById("startDate").value;
    const end   = document.getElementById("endDate").value;
    const classification = document.getElementById("classification").value;
    const params = [];

    let url = "/events";

    function formatDate(date, endOfDay = false) {
        if (!date) return null;

        const d = new Date(date);
        if (isNaN(d)) return null;

        if (endOfDay) {
            d.setUTCHours(23, 59, 59);
        } else {
            d.setUTCHours(0, 0, 0);
        }

        return d.toISOString().split('.')[0] + "Z";
    }

    const startISO = formatDate(start);
    const endISO   = formatDate(end, true);

    if (startISO && endISO) {
        url += `?start=${startISO}&end=${endISO}`;
    }

    if (classification) {
        params.push(`classification=${classification}`);
    }

    if (params.length > 0) {
        url += "?" + params.join("&");
    }

    const response = await fetch(url);
    const events = await response.json();
    const grouped = groupByVenue(events);
    const infoWindow = new google.maps.InfoWindow();

    grouped.forEach(group => {
        const marker = new google.maps.Marker({
            position: {
                lat: parseFloat(group.lat),
                lng: parseFloat(group.lng)
            },
            map: map,
            title: group.venue,
            label: `${group.events.length}`
        });

        marker.addListener("click", () => {
            const sorted = group.events.sort(
                (a, b) => new Date(a.date) - new Date(b.date)
            );

            const eventList = sorted.map(e => `
                <li style="margin-bottom:8px;">
                    <strong>${e.name}</strong><br>
                    ${e.date}
                </li>
            `).join("");

            infoWindow.setContent(`
                <div style="max-width:250px">
                    <h3>${group.venue}</h3>
                    <ul style="padding-left:15px;">
                        ${eventList}
                    </ul>
                </div>
            `);

            infoWindow.open(map, marker);
        });

        markers.push(marker);
    });
}

function initMap() {
    map = new google.maps.Map(document.getElementById("map"), {
        center: { lat: 35.1495, lng: -90.0490 },
        zoom: 12,
        restriction: {
            latLngBounds: memphisBounds,
            strictBounds: true,
        }
    });

    directionsService = new google.maps.DirectionsService();
    directionsRenderer = new google.maps.DirectionsRenderer();
    directionsRenderer.setMap(map);

    const options = {
        bounds: memphisBounds,
        strictBounds: true,
    };

    originAutocomplete = new google.maps.places.Autocomplete(
        document.getElementById("origin"),
        options
    );

    destinationAutocomplete = new google.maps.places.Autocomplete(
        document.getElementById("destination"),
        options
    );

    loadEvents();
}

function getDirections() {
    const origin = document.getElementById("origin").value;
    const destination = document.getElementById("destination").value;

    directionsService.route({
        origin: origin,
        destination: destination,
        travelMode: "DRIVING",
    }, (result, status) => {
        if (status === "OK") {
            directionsRenderer.setDirections(result);
        } else {
            alert("Directions failed: " + status);
        }
    });
}
</script>

<script async
src="https://maps.googleapis.com/maps/api/js?key=REDACTED_API_KEY&libraries=places&callback=initMap">
</script>