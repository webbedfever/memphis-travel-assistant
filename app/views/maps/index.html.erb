<input id="origin" placeholder="Start location">
<input id="destination" placeholder="Destination">
<button onclick="getDirections()">Get Directions</button>

<div id="map" style="height: 500px;"></div>

<input type="date" id="startDate">
<input type="date" id="endDate">

<select id="classification">
    <option value="">All Events</option>
    <option value="Music">Music</option>
    <option value="Sports">Sports</option>
    <option value="Arts & Theatre">Arts & Theatre</option>
    <option value="Film">Film</option>
    <option value="Miscellaneous">Misc</option>
</select>

<input type="datetime-local" id="timeFilter">

<button onclick="applyFilters()">Apply Filters</button>

<select id="placeType">
    <option value="restaurant">Restaurants</option>
    <option value="cafe">Cafes</option>
    <option value="bar">Bars</option>
    <option value="tourist_attraction">Attractions</option>
    <option value="museum">Museums</option>
    <option value="park">Parks</option>
    <option value="store">Stores</option>
</select>


<script>
let markers = [];
let placeMarkers = [];
let map;
let directionsService;
let directionsRenderer;
let originAutocomplete;
let destinationAutocomplete;

const memphisBounds = {
    north: 35.3,
    south: 35.0,
    west: -90.2,
    east: -89.8,
};

function clearMarkers(list) {
    list.forEach(m => m.setMap(null));
}

function groupByVenue(events) {
    const groups = {};

    events.forEach(event => {
        if (!event.lat || !event.lng) return;

        const key = `${parseFloat(event.lat).toFixed(4)},${parseFloat(event.lng).toFixed(4)}`;

        if (!groups[key]) {
            groups[key] = {
                lat: event.lat,
                lng: event.lng,
                venue: event.venue,
                events: []
            };
        }

        groups[key].events.push(event);
    });

    return Object.values(groups);
}

function filterEventsByTime(events, selectedTime) {
    if (!selectedTime) return events;

    const t = new Date(selectedTime);

    return events.filter(e => {
        if (!e.date) return false;
        return new Date(e.date) >= t;
    });
}

function filterOpenPlaces(places) {
    return places.filter(p => p.open_now === true);
}

async function applyFilters() {
    const selectedTime = document.getElementById("timeFilter").value;

    await loadEvents(selectedTime);
    await loadPlaces();
}

async function loadEvents(selectedTime = null) {
    clearMarkers(markers);
    markers = [];

    const start = document.getElementById("startDate").value;
    const end = document.getElementById("endDate").value;
    const classification = document.getElementById("classification").value;

    function formatDate(date, endOfDay = false) {
        if (!date) return null;

        const d = new Date(date);
        if (isNaN(d)) return null;

        d.setUTCHours(endOfDay ? 23 : 0, endOfDay ? 59 : 0, endOfDay ? 59 : 0);

        return d.toISOString().split('.')[0] + "Z";
    }

    let url = "/events";
    const params = [];

    const startISO = formatDate(start);
    const endISO = formatDate(end, true);

    if (startISO) params.push(`start=${startISO}`);
    if (endISO) params.push(`end=${endISO}`);
    if (classification) params.push(`classification=${classification}`);

    if (params.length > 0) {
        url += "?" + params.join("&");
    }

    const response = await fetch(url);
    let events = await response.json();

    if (selectedTime) {
        events = filterEventsByTime(events, selectedTime);
    }

    const grouped = groupByVenue(events);
    const infoWindow = new google.maps.InfoWindow();

    grouped.forEach(group => {
        const marker = new google.maps.Marker({
            position: {
                lat: parseFloat(group.lat),
                lng: parseFloat(group.lng)
            },
            map: map,
            title: group.venue,
            label: String(group.events.length)
        });

        marker.addListener("click", () => {
            const sorted = group.events.sort(
                (a, b) => new Date(a.date) - new Date(b.date)
            );

            const list = sorted.map(e => `
                <li>
                    <strong>${e.name}</strong><br>
                    ${e.date}
                </li>
            `).join("");

            infoWindow.setContent(`
                <div style="max-width:250px">
                    <h3>${group.venue}</h3>
                    <ul>${list}</ul>
                </div>
            `);

            infoWindow.open(map, marker);
        });

        markers.push(marker);
    });
}

async function loadPlaces() {
    const infoWindow = new google.maps.InfoWindow();
    clearMarkers(placeMarkers);
    placeMarkers = [];

    const bounds = map.getBounds();
    const center = map.getCenter();
    const ne = bounds.getNorthEast();
    const lat = center.lat();
    const lng = center.lng();    
    const radius = google.maps.geometry.spherical.computeDistanceBetween(center, ne);
    const type = document.getElementById("placeType").value;

    let url = `/places?lat=${lat}&lng=${lng}&radius=${radius}&type=${type}`;

    const res = await fetch(url);
    const places = await res.json();
    const openPlaces = filterOpenPlaces(places);

    openPlaces.forEach(place => {
        const lat = place.lat;
        const lng = place.lng;

        if (!lat || !lng) return;

        const marker = new google.maps.Marker({
            position: { lat: parseFloat(lat), lng: parseFloat(lng) },
            map: map,
            title: place.name,
            icon: "http://maps.google.com/mapfiles/ms/icons/green-dot.png"
        });

        marker.addListener("click", () => {
            infoWindow.setContent(`
                <div style="max-width:200px">
                <strong>${place.name}</strong><br>
                ${place.address || ""}<br>
                ${place.rating || "N/A"}
                </div>
            `);
            infoWindow.open(map, marker);
        });

        placeMarkers.push(marker);
    });
}

async function applyFilters() {
    const selectedTime = document.getElementById("timeFilter").value;

    await loadEvents(selectedTime);
    await loadPlaces();
}

function initMap() {
    map = new google.maps.Map(document.getElementById("map"), {
        center: { lat: 35.1495, lng: -90.0490 },
        zoom: 12,
        restriction: {
            latLngBounds: memphisBounds,
            strictBounds: true,
        }
    });

    directionsService = new google.maps.DirectionsService();
    directionsRenderer = new google.maps.DirectionsRenderer();
    directionsRenderer.setMap(map);

    const options = {
        bounds: memphisBounds,
        strictBounds: true,
    };

    originAutocomplete = new google.maps.places.Autocomplete(
        document.getElementById("origin"),
        options
    );

    destinationAutocomplete = new google.maps.places.Autocomplete(
        document.getElementById("destination"),
        options
    );

    google.maps.event.addListenerOnce(map, 'idle', () => {
        loadEvents();
        loadPlaces();
    });
}

function getDirections() {
    const origin = document.getElementById("origin").value;
    const destination = document.getElementById("destination").value;

    directionsService.route({
        origin,
        destination,
        travelMode: "DRIVING",
    }, (result, status) => {
        if (status === "OK") {
            directionsRenderer.setDirections(result);
        } else {
            alert("Directions failed: " + status);
        }
    });
}
</script>

<script async
src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_API_KEY'] %>&libraries=places,geometry&callback=initMap">
</script>