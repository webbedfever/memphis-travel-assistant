<style>
	.maps-page {
		padding: 24px;
	}

	.maps-toolbar,
	.maps-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-bottom: 16px;
	}

	.maps-toolbar input,
	.maps-filters input,
	.maps-filters select {
		min-width: 180px;
		padding: 10px 12px;
		border: 1px solid #cfd4dc;
		border-radius: 10px;
		background: #fff;
	}

	.maps-action-button {
		padding: 10px 16px;
		border: none;
		border-radius: 10px;
		background: #1f6f78;
		color: #fff;
		font-weight: 600;
	}

	.maps-results {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
		margin-top: 24px;
		align-items: stretch;
	}

	.maps-panel {
		display: flex;
		flex-direction: column;
		min-height: 420px;
		max-height: 420px;
		padding: 16px;
		border: 1px solid #d8dee6;
		border-radius: 16px;
		background: #fafbfc;
		box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
	}

	.maps-panel h2 {
		margin: 0 0 12px;
		font-size: 1.2rem;
	}

	.maps-panel-list {
		flex: 1;
		overflow-y: auto;
		padding-right: 8px;
	}

	.maps-group-card {
		margin-bottom: 12px;
		padding: 12px 14px;
		border: 1px solid #dde3ea;
		border-radius: 14px;
		background: #fff;
	}

	.maps-group-title {
		display: block;
		margin-bottom: 10px;
		font-size: 0.98rem;
	}

	.maps-group-card ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.maps-result-item {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
		padding: 8px 0;
	}

	.maps-result-item + .maps-result-item {
		border-top: 1px solid #eef2f6;
	}

	.maps-result-copy {
		min-width: 0;
	}

	.maps-result-copy strong {
		display: block;
		margin-bottom: 2px;
		font-size: 0.95rem;
	}

	.maps-result-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 10px;
		color: #5f6b7a;
		font-size: 0.86rem;
	}

	.planner-inline-action {
		flex-shrink: 0;
		padding: 4px 10px;
		border: 1px solid #ccd6dd;
		border-radius: 999px;
		background: transparent;
		color: #47606a;
		font-size: 0.78rem;
		font-weight: 600;
		opacity: 0.42;
		transition: opacity 0.2s ease, background-color 0.2s ease, color 0.2s ease;
	}

	.maps-result-item:hover .planner-inline-action,
	.planner-inline-action:focus-visible,
	.planner-inline-action[data-saved="true"] {
		opacity: 1;
	}

	.planner-inline-action[data-saved="true"] {
		border-color: #1f6f78;
		background: #e7f4f5;
		color: #1f6f78;
	}

	@media (max-width: 768px) {
		.maps-page {
			padding: 16px;
		}

		.maps-results {
			grid-template-columns: 1fr;
		}

		.maps-panel {
			min-height: 320px;
			max-height: 320px;
		}

		.planner-inline-action {
			opacity: 1;
		}
	}
</style>

<div class="maps-page">
	<div class="maps-toolbar">
		<input id="origin" placeholder="Start location">
		<input id="destination" placeholder="Destination">
		<button class="maps-action-button" onclick="getDirections()">Get Directions</button>
	</div>

	<div
		id="map"
		data-google-maps-api-key="<%= ENV['GOOGLE_API_KEY'] %>"
		style="height: 500px; border-radius: 18px; overflow: hidden;"></div>

	<div class="maps-filters">
		<input type="date" id="startDate">
		<input type="date" id="endDate">

		<select id="classification">
			<option value="">All Events</option>
			<option value="Music">Music</option>
			<option value="Sports">Sports</option>
			<option value="Arts & Theatre">Arts & Theatre</option>
			<option value="Film">Film</option>
			<option value="Miscellaneous">Misc</option>
		</select>

		<select id="placeType">
			<option value="restaurant">Restaurants</option>
			<option value="cafe">Cafes</option>
			<option value="bar">Bars</option>
			<option value="tourist_attraction">Attractions</option>
			<option value="museum">Museums</option>
			<option value="park">Parks</option>
			<option value="store">Stores</option>
		</select>

		<button class="maps-action-button" onclick="applyFilters()">Apply Filters</button>
	</div>

	<div id="results" class="maps-results">
		<section class="maps-panel">
			<h2>Events</h2>
			<div id="eventList" class="maps-panel-list"></div>
		</section>

		<section class="maps-panel">
			<h2>Places</h2>
			<div id="placeList" class="maps-panel-list"></div>
		</section>
	</div>
</div>
