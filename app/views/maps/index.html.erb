<div class="maps-page container">
	<div class="maps-header">
		<div>
			<p class="maps-eyebrow">Memphis Travel Assistant</p>
			<h1>Explore Memphis</h1>
		</div>
		<span class="maps-header-meta">Events, places, and routes</span>
	</div>

	<div class="maps-controls">
		<div class="maps-toolbar" aria-label="Directions">
			<input id="origin" placeholder="Start location">
			<input id="destination" placeholder="Destination">
			<button class="maps-action-button" onclick="getDirections()">Get Directions</button>
		</div>

		<div
			id="map"
			class="maps-canvas"
			data-google-maps-api-key="<%= ENV['GOOGLE_API_KEY'] %>"></div>
	</div>

	<div class="maps-filters">
		<input type="date" id="startDate">
		<input type="date" id="endDate">
		<input type="time" id="startTime" aria-label="Start time">
		<input type="time" id="endTime" aria-label="End time">

		<select id="classification">
			<option value="">All Events</option>
			<option value="Music">Music</option>
			<option value="Sports">Sports</option>
			<option value="Arts & Theatre">Arts & Theatre</option>
			<option value="Film">Film</option>
			<option value="Miscellaneous">Misc</option>
		</select>

		<select id="placeType">
			<option value="">All Places</option>
			<option value="restaurant">Restaurants</option>
			<option value="cafe">Cafes</option>
			<option value="bar">Bars</option>
			<option value="tourist_attraction">Attractions</option>
			<option value="museum">Museums</option>
			<option value="park">Parks</option>
			<option value="store">Stores</option>
		</select>

		<button
			type="button"
			id="openNowButton"
			class="maps-toggle-button"
			aria-pressed="false"
			onclick="toggleOpenNowFilter()">
			Open Now
		</button>

		<button class="maps-action-button" onclick="applyFilters()">Apply Filters</button>
		<button type="button" class="maps-reset-button" onclick="resetFilters()">Reset Filters</button>
	</div>

	<div id="results" class="maps-results">
		<section class="maps-panel">
			<div class="maps-panel-heading">
				<h2>Events</h2>
				<span class="maps-panel-count">Nearby</span>
			</div>
			<div id="eventList" class="maps-panel-list"></div>
		</section>

		<section class="maps-panel">
			<div class="maps-panel-heading">
				<h2>Places</h2>
				<span class="maps-panel-count">Local</span>
			</div>
			<div id="placeList" class="maps-panel-list"></div>
		</section>
	</div>
</div>
