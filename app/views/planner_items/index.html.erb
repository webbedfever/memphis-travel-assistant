<div class="planner-page container">
	<div class="planner-header">
		<div>
			<p class="planner-eyebrow">Memphis Travel Assistant</p>
			<h1>My Planner</h1>
		</div>
		<span class="planner-total"><%= pluralize(@planner_items.size, "saved item") %></span>
	</div>

	<% if @planner_items.any? %>
		<div class="planner-timeline">
			<% @planner_items.group_by { |item| item.start_time&.to_date || item.created_at.to_date }.each do |date, items| %>
				<section class="planner-day">
					<div class="planner-day-heading">
						<h2><%= date.strftime("%A, %B %d, %Y") %></h2>
						<span><%= pluralize(items.size, "item") %></span>
					</div>

					<div class="planner-day-list">
						<% items.each do |item| %>
							<% ticketmaster_time_known = item.external_id.to_s.match?(/T\d{2}:\d{2}/) || item.start_time.blank? || !item.start_time.strftime("%H:%M:%S").eql?("00:00:00") %>
							<% time_unknown = item.source == "ticketmaster" && !ticketmaster_time_known %>
							<% website_url = safe_external_url(item.website) %>
							<% google_url = safe_external_url(item.google_url) %>
							<% ticketmaster_url = safe_external_url(item.ticketmaster_url) %>
							<% reminder_location = item.location_name.presence || item.address %>

							<article
								class="planner-item"
								data-reminder-item
								data-reminder-at="<%= item.reminder_at&.iso8601 %>"
								data-reminder-title="<%= item.title %>"
								data-reminder-location="<%= reminder_location %>">
								<div class="planner-item-main">
									<div class="planner-item-copy">
										<div class="planner-item-title-row">
											<span class="planner-type-badge"><%= item.item_type.to_s.tr("_", " ").titleize %></span>
											<h3><%= item.title %></h3>
										</div>

										<div class="planner-quick-meta">
											<% if item.start_time.present? %>
												<span>
													<%= time_unknown ? "Time TBA" : item.start_time.strftime("%I:%M %p") %>
													<% if item.end_time.present? && !time_unknown %>
														- <%= item.end_time.strftime("%I:%M %p") %>
													<% end %>
												</span>
											<% end %>

											<% if item.location_name.present? %>
												<span><%= item.location_name %></span>
											<% end %>
										</div>
									</div>

									<button
										type="button"
										class="delete-planner-item"
										data-planner-item-id="<%= item.id %>">
										Remove
									</button>
								</div>

								<details class="planner-reminder-dropdown" <%= "open" if item.reminder_enabled? %>>
									<summary>
										<span>Notifications</span>
										<span class="planner-reminder-status"><%= item.reminder_label %></span>
									</summary>

									<form class="planner-reminder-form" data-planner-item-id="<%= item.id %>">
										<%= hidden_field_tag "planner_item[reminder_enabled]", "0" %>

										<label class="planner-reminder-toggle">
											<%= check_box_tag "planner_item[reminder_enabled]", "1", item.reminder_enabled?, class: "planner-reminder-enabled" %>
											<span>Send reminder</span>
										</label>

										<div class="planner-reminder-controls">
											<% if item.start_time.present? %>
												<label>
													<span>When</span>
													<%= select_tag(
														"planner_item[reminder_minutes_before]",
														options_for_select(
															[
																["Custom time", ""],
																["At start time", 0],
																["15 minutes before", 15],
																["30 minutes before", 30],
																["1 hour before", 60],
																["1 day before", 1440]
															],
															item.reminder_minutes_before
														),
														class: "planner-reminder-offset"
													) %>
												</label>
											<% end %>

											<label>
												<span>Custom time</span>
												<%= datetime_field_tag(
													"planner_item[reminder_at]",
													item.reminder_at&.strftime("%Y-%m-%dT%H:%M"),
													class: "planner-reminder-at"
												) %>
											</label>

											<button type="submit" class="planner-reminder-save">Save</button>
										</div>

										<div class="planner-reminder-footer">
											<button type="button" class="planner-browser-notifications">Browser notifications</button>
										</div>
									</form>
								</details>

								<details class="planner-item-details">
									<summary>Details</summary>

									<div class="planner-detail-grid">
										<% if item.address.present? %>
											<div class="planner-detail-row">
												<span>Address</span>
												<strong><%= item.address %></strong>
											</div>
										<% end %>

										<% if item.category.present? %>
											<div class="planner-detail-row">
												<span>Category</span>
												<strong><%= item.category %></strong>
											</div>
										<% end %>

										<% if item.item_type == "place" %>
											<% if item.rating.present? %>
												<div class="planner-detail-row">
													<span>Rating</span>
													<strong><%= item.rating %></strong>
												</div>
											<% end %>

											<% unless item.open_now.nil? %>
												<div class="planner-detail-row">
													<span>Status</span>
													<strong><%= item.open_now? ? "Open now" : "Closed now" %></strong>
												</div>
											<% end %>

											<% if item.hours_for_day.present? || item.hours_day.present? %>
												<div class="planner-detail-row">
													<span>Hours</span>
													<strong><%= item.hours_for_day.presence || "#{item.hours_day} hours unavailable" %></strong>
												</div>
											<% end %>

											<% if item.phone.present? %>
												<div class="planner-detail-row">
													<span>Phone</span>
													<strong><%= item.phone %></strong>
												</div>
											<% end %>
										<% end %>

										<% if item.notes.present? %>
											<div class="planner-detail-row planner-detail-row-wide">
												<span>Notes</span>
												<strong><%= item.notes %></strong>
											</div>
										<% end %>

										<% if website_url.present? || google_url.present? || ticketmaster_url.present? %>
											<div class="planner-links">
												<% if website_url.present? %>
													<%= link_to "Website", website_url, target: "_blank", rel: "noopener" %>
												<% end %>
												<% if google_url.present? %>
													<%= link_to "Google listing", google_url, target: "_blank", rel: "noopener" %>
												<% end %>
												<% if ticketmaster_url.present? %>
													<%= link_to "Ticketmaster", ticketmaster_url, target: "_blank", rel: "noopener" %>
												<% end %>
											</div>
										<% end %>
									</div>
								</details>
							</article>
						<% end %>
					</div>
				</section>
			<% end %>
		</div>
	<% else %>
		<div class="planner-empty">No planner items saved yet.</div>
	<% end %>
</div>
