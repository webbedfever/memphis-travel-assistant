<h1>My Planner</h1>

<% if @planner_items.any? %>
    <% @planner_items.group_by { |item| item.start_time&.to_date || item.created_at.to_date }.each do |date, items| %>
		<div class="planner-day">
			<h2><%= date.strftime("%A, %B %d, %Y") %></h2>

			<% items.each do |item| %>
				<div class="planner-item">
					<strong><%= item.title %></strong>
					<span>(<%= item.item_type.capitalize %>)</span>

					<% if item.start_time.present? %>
						<div>
							<% ticketmaster_time_known = item.external_id.to_s.match?(/T\d{2}:\d{2}/) || !item.start_time.strftime("%H:%M:%S").eql?("00:00:00") %>
							<% time_unknown = item.source == "ticketmaster" && !ticketmaster_time_known %>
							Time: <%= time_unknown ? "TBA" : item.start_time.strftime("%I:%M %p") %>
							<% if item.end_time.present? && !time_unknown %>
								- <%= item.end_time.strftime("%I:%M %p") %>
							<% end %>
						</div>
					<% end %>

					<% if item.location_name.present? %>
						<div>Location: <%= item.location_name %></div>
					<% end %>

					<% if item.address.present? %>
						<div>Address: <%= item.address %></div>
					<% end %>

					<% if item.item_type == "place" %>
						<% if item.rating.present? %>
							<div>Rating: <%= item.rating %></div>
						<% end %>

						<% unless item.open_now.nil? %>
							<div>Status: <%= item.open_now? ? "Open now" : "Closed now" %></div>
						<% end %>

						<% if item.hours_for_day.present? %>
							<div>Hours: <%= item.hours_for_day %></div>
						<% elsif item.hours_day.present? %>
							<div>Hours: <%= item.hours_day %> hours unavailable</div>
						<% end %>

						<% if item.phone.present? %>
							<div>Phone: <%= item.phone %></div>
						<% end %>

						<% website_url = safe_external_url(item.website) %>
						<% google_url = safe_external_url(item.google_url) %>

						<% if website_url.present? || google_url.present? %>
							<div>
								<% if website_url.present? %>
									<%= link_to "Website", website_url, target: "_blank", rel: "noopener" %>
								<% end %>
								<% if google_url.present? %>
									<%= link_to "Google listing", google_url, target: "_blank", rel: "noopener" %>
								<% end %>
							</div>
						<% end %>
					<% end %>

					<% if item.item_type == "event" %>
						<% ticketmaster_url = safe_external_url(item.ticketmaster_url) %>

						<% if ticketmaster_url.present? %>
							<div>
								<%= link_to "Ticketmaster", ticketmaster_url, target: "_blank", rel: "noopener" %>
							</div>
						<% end %>
					<% end %>

					<% if item.notes.present? %>
						<div>Notes: <%= item.notes %></div>
					<% end %>

					<button
                        type="button"
						class="delete-planner-item"
						data-planner-item-id="<%= item.id %>">
						Remove
					</button>
				</div>
			<% end %>
		</div>
	<% end %>
<% else %>
	<p>No planner items saved yet.</p>
<% end %>
