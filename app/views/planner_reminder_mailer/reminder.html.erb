<h1><%= @planner_item.title %></h1>

<p>This is your reminder from Memphis Travel Assistant.</p>

<% if @planner_item.start_time.present? %>
  <p>
    <strong>Starts:</strong>
    <%= @planner_item.start_time.strftime("%A, %B %-d at %-I:%M %p") %>
  </p>
<% end %>

<% if @planner_item.location_name.present? || @planner_item.address.present? %>
  <p>
    <strong>Location:</strong>
    <%= [@planner_item.location_name, @planner_item.address].compact_blank.join(" - ") %>
  </p>
<% end %>

<% if @planner_item.notes.present? %>
  <p><strong>Notes:</strong> <%= @planner_item.notes %></p>
<% end %>
