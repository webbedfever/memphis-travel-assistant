<nav class="navbar navbar-expand-lg app-navbar">
  <div class="container-fluid">

    <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-2" do %>
      <span>Memphis Travel Assistant</span>
    <% end %>

    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavDropdown"
            aria-controls="navbarNavDropdown"
            aria-expanded="false"
            aria-label="Toggle navigation">

      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavDropdown">

      <ul class="navbar-nav me-auto">

        <li class="nav-item">
          <%= link_to root_path, class: "nav-link #{active_class(root_path)}" do %>
            Home
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to maps_path, class: "nav-link #{active_class(maps_path)}" do %>
            Maps
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to planner_path, class: "nav-link #{active_class(planner_path)}" do %>
            Planner
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to dashboard_path, class: "nav-link #{active_class(dashboard_path)}" do %>
            Dashboard
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to weather_path, class: "nav-link #{active_class(weather_path)}" do %>
            Weather
          <% end %>
        </li>

      </ul>

      <div class="navbar-account d-flex align-items-center">

        <% if user_signed_in? %>
          <% account_name = current_user.display_name %>
          <div class="account-menu">
            <%= link_to account_path, class: "account-summary", aria: { label: "Open account settings" } do %>
              <span class="account-avatar"><%= account_name.first.to_s.upcase %></span>
              <span class="account-copy">
                <strong><%= account_name %></strong>
                <small>Account</small>
              </span>
            <% end %>
            <%= button_to "Sign out",
                  destroy_user_session_path,
                  method: :delete,
                  class: "account-sign-out" %>
          </div>
        <% else %>

          <%= link_to new_user_session_path,
                class: "account-login-link" do %>
            <span>Log in</span>
          <% end %>

        <% end %>

      </div>

    </div>
  </div>
</nav>
