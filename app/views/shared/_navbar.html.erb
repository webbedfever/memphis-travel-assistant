<nav class="navbar navbar-expand-lg app-navbar">
  <div class="container-fluid">

    <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-2" do %>
      <span>Memphis Travel Assistant</span>
    <% end %>

    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavDropdown"
            aria-controls="navbarNavDropdown"
            aria-expanded="false"
            aria-label="Toggle navigation">

      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavDropdown">

      <ul class="navbar-nav me-auto">

        <li class="nav-item">
          <%= link_to root_path, class: "nav-link #{active_class(root_path)}" do %>
            Home
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to maps_path, class: "nav-link #{active_class(maps_path)}" do %>
            Maps
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to dashboard_path, class: "nav-link #{active_class(dashboard_path)}" do %>
            Dashboard
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to planner_path, class: "nav-link #{active_class(planner_path)}" do %>
            My Planner
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to weather_path, class: "nav-link #{active_class(weather_path)}" do %>
            Weather
          <% end %>
        </li>

      </ul>

      <div class="navbar-account d-flex align-items-center">

        <% if user_signed_in? %>
          <%= button_to "Sign Out",
                destroy_user_session_path,
                method: :delete,
                class: "btn btn-dark" %>
        <% else %>

          <%= link_to new_user_session_path,
                class: "text-decoration-none" do %>

            <div class="user-profile" tabindex="0" role="button" aria-label="Log In">
              <div class="user-profile-inner">

                <!-- ICON -->
                <svg aria-hidden="true"
                     xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24">
                  <path d="m15.626 11.769a6 6 0 1 0 -7.252 0 9.008 9.008 0 0 0 -5.374 8.231 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 9.008 9.008 0 0 0 -5.374-8.231zm-7.626-4.769a4 4 0 1 1 4 4 4 4 0 0 1 -4-4zm10 14h-12a1 1 0 0 1 -1-1 7 7 0 0 1 14 0 1 1 0 0 1 -1 1z"></path>
                </svg>

                <span>Log In</span>

              </div>
            </div>

          <% end %>

        <% end %>

      </div>

    </div>
  </div>
</nav>
